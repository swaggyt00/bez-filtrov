.switch-row span { display: flex; flex-direction: column; gap: 3px; }
.switch-row strong { font-size: 13px; }
.switch-row small { color: rgba(255,255,255,.4); line-height: 1.35; }
.switch-row input { width: 42px; height: 24px; accent-color: #ff4f91; flex: 0 0 auto; }

.saved-list { display: grid; gap: 8px; }
.saved-row { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 8px; }
.saved-main { min-height: 58px; border-radius: 14px; padding: 10px 12px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); text-align: left; display: flex; flex-direction: column; gap: 4px; }
.saved-main span { font-size: 11px; color: rgba(255,255,255,.4); }

.custom-editor { display: grid; gap: 12px; margin-top: 14px; }
.custom-editor textarea { min-height: 110px; padding: 12px 14px; resize: vertical; }
.mini-label { display: grid; gap: 6px; color: rgba(255,255,255,.58); font-size: 12px; }
.chip-wrap { display: flex; flex-wrap: wrap; gap: 6px; }
.tiny-chip { padding: 7px 9px; border-radius: 10px; background: rgba(255,255,255,.055); border: 1px solid rgba(255,255,255,.07); color: rgba(255,255,255,.56); font-size: 11px; }
.tiny-chip.active { color: #fff; border-color: rgba(255,83,146,.5); background: rgba(255,54,127,.13); }
.custom-row { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center; padding: 10px 0; border-top: 1px solid rgba(255,255,255,.06); }
.custom-row span { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; font-size: 11px; color: rgba(255,255,255,.5); }

.sticky-cta { position: fixed; bottom: max(16px, env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%); width: min(calc(100% - 36px), 744px); z-index: 12; }
.notice { margin: 12px 0; padding: 12px 14px; border-radius: 14px; background: rgba(255,199,84,.11); color: #ffdb98; border: 1px solid rgba(255,199,84,.22); font-size: 12px; line-height: 1.45; }
.notice.compact { margin-top: 18px; }

.game-shell { display: flex; flex-direction: column; padding-bottom: 88px; transition: background .3s ease; }
.game-shell.special-boss::before { content: ''; position: fixed; inset: 0; pointer-events: none; background: radial-gradient(circle at 50% 30%, rgba(255,55,90,.09), transparent 45%); }
.game-shell.special-duo::before { content: ''; position: fixed; inset: 0; pointer-events: none; background: radial-gradient(circle at 50% 30%, rgba(123,88,255,.08), transparent 45%); }
.game-header { color: rgba(255,255,255,.48); font-size: 12px; }
.ghost-button { background: transparent; color: rgba(255,255,255,.65); padding: 8px 0; }
.turn-wrap { flex: 1; display: flex; flex-direction: column; justify-content: center; text-align: center; position: relative; z-index: 1; }
.turn-kicker { color: rgba(255,255,255,.4); font-size: 12px; margin-bottom: 8px; text-transform: uppercase; letter-spacing: .1em; }
.player-title { font-size: clamp(48px, 16vw, 88px); margin: 0; word-break: break-word; }
.choice-question { margin: 24px 0 18px; font-size: 20px; color: rgba(255,255,255,.7); }
.special-banner { align-self: center; margin-bottom: 18px; padding: 8px 12px; border-radius: 999px; font-size: 11px; font-weight: 900; letter-spacing: .05em; }
.special-banner.boss { background: rgba(255,65,91,.12); border: 1px solid rgba(255,82,105,.3); color: #ff98aa; }
.special-banner.duo { background: rgba(139,89,255,.12); border: 1px solid rgba(139,89,255,.3); color: #c1a7ff; }

.big-choice-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.truth-button, .dare-button { min-height: 194px; border: 1px solid rgba(255,255,255,.12); border-radius: 28px; color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; font-weight: 900; cursor: pointer; box-shadow: 0 20px 55px rgba(0,0,0,.23); transition: transform .15s ease, filter .15s ease; }
.truth-button:hover, .dare-button:hover { transform: translateY(-2px); filter: brightness(1.06); }
.truth-button:active, .dare-button:active { transform: scale(.985); }
.truth-button { background: linear-gradient(155deg, rgba(255,55,126,.92), rgba(147,49,126,.62)); }
.dare-button { background: linear-gradient(155deg, rgba(134,83,255,.96), rgba(62,43,126,.68)); }
.choice-letter { font-size: 72px; line-height: 1; font-weight: 950; }
.followup-hint { margin: 14px auto 0; color: rgba(255,255,255,.42); font-size: 11px; }

.challenge-card { text-align: left; padding: 22px; margin-top: 24px; animation: cardIn .24s ease both; }
@keyframes cardIn { from { opacity: 0; transform: translateY(10px) scale(.985); } to { opacity: 1; transform: translateY(0) scale(1); } }
.card-meta { display: flex; justify-content: space-between; gap: 10px; color: #ff79ae; font-size: 10px; font-weight: 950; letter-spacing: .09em; }
.challenge-text { font-size: clamp(24px, 6.3vw, 38px); line-height: 1.18; letter-spacing: -.025em; font-weight: 840; margin: 27px 0 18px; }
.tag-row { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px; }
.tag-row span { padding: 6px 8px; border-radius: 999px; background: rgba(255,255,255,.06); color: rgba(255,255,255,.43); font-size: 10px; }
.alcohol-note { padding: 10px 11px; border-radius: 12px; background: rgba(255,199,84,.08); border: 1px solid rgba(255,199,84,.13); color: rgba(255,221,160,.68); font-size: 10px; line-height: 1.45; margin-bottom: 12px; }
.difficulty-feedback { display: grid; grid-template-columns: 1fr repeat(3, auto); gap: 6px; align-items: center; margin: 12px 0 14px; }
.difficulty-feedback span { font-size: 10px; color: rgba(255,255,255,.38); }
.difficulty-feedback button { padding: 7px 8px; border-radius: 9px; background: rgba(255,255,255,.055); color: rgba(255,255,255,.58); font-size: 10px; }
.difficulty-feedback button:hover { background: rgba(255,255,255,.1); }
.difficulty-feedback button.disabled { pointer-events: none; opacity: .38; }
.card-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.card-actions .secondary-button { margin-top: 10px; }

.player-strip { position: fixed; left: 50%; bottom: max(10px, env(safe-area-inset-bottom)); transform: translateX(-50%); width: min(calc(100% - 24px), 756px); display: flex; gap: 7px; overflow-x: auto; padding: 8px; border-radius: 18px; background: rgba(9,6,13,.84); border: 1px solid rgba(255,255,255,.08); backdrop-filter: blur(18px); z-index: 10; }
.player-strip span { white-space: nowrap; padding: 8px 12px; border-radius: 12px; color: rgba(255,255,255,.36); font-size: 11px; }
.player-strip span.active { background: rgba(255,255,255,.1); color: #fff; }

.summary-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 24px 0; }
.summary-grid div { min-height: 90px; border-radius: 18px; background: rgba(255,255,255,.055); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; }
.summary-grid strong { font-size: 26px; }
.summary-grid span { font-size: 10px; color: rgba(255,255,255,.42); }

@media (max-width: 520px) {
  .app-shell { padding-left: 14px; padding-right: 14px; }
  .choice-grid, .category-grid, .mode-grid { grid-template-columns: 1fr; }
  .mode-card { min-height: 112px; }
  .boundary-grid { grid-template-columns: 1fr 1fr; }
  .segmented.four { grid-template-columns: 1fr 1fr; }
  .big-choice-grid { gap: 10px; }
  .truth-button, .dare-button { min-height: 172px; border-radius: 24px; }
  .choice-letter { font-size: 58px; }
  .card-actions { grid-template-columns: 1fr; gap: 0; }
  .difficulty-feedback { grid-template-columns: 1fr 1fr 1fr; }
  .difficulty-feedback span { grid-column: 1 / -1; }
}
